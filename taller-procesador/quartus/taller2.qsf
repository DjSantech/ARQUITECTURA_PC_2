# Proyecto de Quartus del Taller 2 - procesador monociclo RV32I
# Placa: DE1-SoC (Cyclone V 5CSEMA5F31C6)
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY riscv_monociclo
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/riscv_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/pc.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/alu.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/register_file.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/instruction_memory.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/adder.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/mux2.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/mux4.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/imm_gen.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/data_memory.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/control_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/riscv_monociclo.sv
